[
  {
    "label": "tag simple",
    "source": "div",
    "expected": "<div></div>"
  },
  {
    "label": "tag con texto",
    "source": "p Hello world",
    "expected": "<p>Hello world</p>"
  },
  {
    "label": "tag anidado",
    "source": "div\n  p Hello\n",
    "expected": "<div><p>Hello</p></div>"
  },
  {
    "label": "tag 3 niveles",
    "source": "div\n  section\n    p Contenido\n",
    "expected": "<div><section><p>Contenido</p></section></div>"
  },
  {
    "label": "clase simple",
    "source": "div.container",
    "expected": "<div class=\"container\"></div>"
  },
  {
    "label": "multiples clases fusionadas",
    "source": "div.box.highlight Content",
    "expected": "<div class=\"box highlight\">Content</div>"
  },
  {
    "label": "clase e id",
    "source": "div.container#main",
    "expected": "<div class=\"container\" id=\"main\"></div>"
  },
  {
    "label": "atributo string estatico",
    "source": "a(href=\"/home\") Inicio",
    "expected": "<a href=\"/home\">Inicio</a>"
  },
  {
    "label": "multiples atributos",
    "source": "input(type=\"text\" placeholder=\"Nombre\" required)",
    "expected": "<input type=\"text\" placeholder=\"Nombre\" required>"
  },
  {
    "label": "atributo boolean",
    "source": "input(disabled)",
    "expected": "<input disabled>"
  },
  {
    "label": "atributo expresion",
    "source": "- var cls = \"primary\"\nbutton(class=cls) Click\n",
    "expected": "<button class=\"primary\">Click</button>"
  },
  {
    "label": "atributo ternario",
    "source": "- var active = true\ndiv(class=active ? \"active\" : \"inactive\")\n",
    "expected": "<div class=\"active\"></div>"
  },
  {
    "label": "br void",
    "source": "br",
    "expected": "<br>"
  },
  {
    "label": "input void",
    "source": "input(type=\"text\")",
    "expected": "<input type=\"text\">"
  },
  {
    "label": "meta void",
    "source": "meta(charset=\"UTF-8\")",
    "expected": "<meta charset=\"UTF-8\">"
  },
  {
    "label": "img void",
    "source": "img(src=\"logo.png\" alt=\"Logo\")",
    "expected": "<img src=\"logo.png\" alt=\"Logo\">"
  },
  {
    "label": "doctype html",
    "source": "doctype html\nhtml\n  head\n    title Test\n  body\n    p Hola\n",
    "expected": "<!DOCTYPE html><html><head><title>Test</title></head><body><p>Hola</p></body></html>"
  },
  {
    "label": "var y uso",
    "source": "- var name = \"Carlos\"\np Hola #{name}\n",
    "expected": "<p>Hola Carlos</p>"
  },
  {
    "label": "var numero",
    "source": "- var x = 10\n- var y = 20\np #{x + y}\n",
    "expected": "<p>30</p>"
  },
  {
    "label": "var array",
    "source": "- var fruits = [\"banana\", \"apple\"]\np #{fruits[0]}\n",
    "expected": "<p>banana</p>"
  },
  {
    "label": "var objeto",
    "source": "- var user = { name: \"Ana\" }\np #{user.name}\n",
    "expected": "<p>Ana</p>"
  },
  {
    "label": "interpolacion escapada",
    "source": "p Hola #{name}",
    "context": [
      {
        "name": "name",
        "value": {
          "string": "Carlos"
        }
      }
    ],
    "expected": "<p>Hola Carlos</p>"
  },
  {
    "label": "interpolacion escapa XSS",
    "source": "p #{content}",
    "context": [
      {
        "name": "content",
        "value": {
          "string": "<script>alert('xss')</script>"
        }
      }
    ],
    "expected": "<p>&lt;script&gt;alert(&#39;xss&#39;)&lt;/script&gt;</p>"
  },
  {
    "label": "interpolacion no escapada",
    "source": "p !{html}",
    "context": [
      {
        "name": "html",
        "value": {
          "string": "<strong>Bold</strong>"
        }
      }
    ],
    "expected": "<p><strong>Bold</strong></p>"
  },
  {
    "label": "interpolacion con expresion",
    "source": "- var price = 10\n- var qty = 3\np Total: #{price * qty}\n",
    "expected": "<p>Total: 30</p>"
  },
  {
    "label": "interpolacion multiple",
    "source": "- var a = \"Hola\"\n- var b = \"mundo\"\np #{a} #{b}!\n",
    "expected": "<p>Hola mundo!</p>"
  },
  {
    "label": "if true",
    "source": "if isAdmin\n  p Admin\n",
    "context": [
      {
        "name": "isAdmin",
        "value": {
          "boolean": true
        }
      }
    ],
    "expected": "<p>Admin</p>"
  },
  {
    "label": "if false",
    "source": "if isAdmin\n  p Admin\n",
    "context": [
      {
        "name": "isAdmin",
        "value": {
          "boolean": false
        }
      }
    ],
    "expected": ""
  },
  {
    "label": "if else",
    "source": "if isAdmin\n  p Admin\nelse\n  p Usuario\n",
    "context": [
      {
        "name": "isAdmin",
        "value": {
          "boolean": false
        }
      }
    ],
    "expected": "<p>Usuario</p>"
  },
  {
    "label": "unless false renderiza",
    "source": "unless isGuest\n  p Bienvenido\n",
    "context": [
      {
        "name": "isGuest",
        "value": {
          "boolean": false
        }
      }
    ],
    "expected": "<p>Bienvenido</p>"
  },
  {
    "label": "unless true no renderiza",
    "source": "unless isGuest\n  p Bienvenido\n",
    "context": [
      {
        "name": "isGuest",
        "value": {
          "boolean": true
        }
      }
    ],
    "expected": ""
  },
  {
    "label": "if else if encadenado",
    "source": "- var role = \"user\"\nif role == \"admin\"\n  p Admin\nelse\n  if role == \"user\"\n    p Usuario\n  else\n    p Invitado\n",
    "expected": "<p>Usuario</p>"
  },
  {
    "label": "each simple",
    "source": "- var items = [\"a\",\"b\",\"c\"]\nul\n  each item in items\n    li #{item}\n",
    "expected": "<ul><li>a</li><li>b</li><li>c</li></ul>"
  },
  {
    "label": "each array literal",
    "source": "each n in [1,2,3]\n  p #{n}\n",
    "expected": "<p>1</p><p>2</p><p>3</p>"
  },
  {
    "label": "each con indice",
    "source": "- var items = [\"x\",\"y\"]\neach item, i in items\n  p #{i}:#{item}\n",
    "expected": "<p>0:x</p><p>1:y</p>"
  },
  {
    "label": "each anidado",
    "source": "- var rows = [[1,2],[3,4]]\neach row in rows\n  each cell in row\n    span #{cell}\n",
    "expected": "<span>1</span><span>2</span><span>3</span><span>4</span>"
  },
  {
    "label": "while simple",
    "source": "- var i = 0\nwhile i < 3\n  p #{i}\n  - i++\n",
    "expected": "<p>0</p><p>1</p><p>2</p>"
  },
  {
    "label": "case match",
    "source": "- var role = \"admin\"\ncase role\n  when \"admin\"\n    p Admin\n  when \"user\"\n    p Usuario\n  default\n    p Invitado\n",
    "expected": "<p>Admin</p>"
  },
  {
    "label": "case default",
    "source": "- var role = \"guest\"\ncase role\n  when \"admin\"\n    p Admin\n  default\n    p Invitado\n",
    "expected": "<p>Invitado</p>"
  },
  {
    "label": "mixin sin params",
    "source": "mixin divider\n  hr\n+divider\n",
    "expected": "<hr>"
  },
  {
    "label": "mixin con params",
    "source": "mixin greet(name)\n  p Hola #{name}\n+greet(\"Carlos\")\n",
    "expected": "<p>Hola Carlos</p>"
  },
  {
    "label": "mixin multiple llamadas",
    "source": "mixin btn(label)\n  button #{label}\n+btn(\"Guardar\")\n+btn(\"Cancelar\")\n",
    "expected": "<button>Guardar</button><button>Cancelar</button>"
  },
  {
    "label": "comentario unbuffered no emite",
    "source": "//- Solo para devs\np Visible\n",
    "expected": "<p>Visible</p>"
  },
  {
    "label": "js + each + if",
    "source": "- var items = [1,2,3]\nul\n  each item in items\n    if item > 1\n      li #{item}\n",
    "expected": "<ul><li>2</li><li>3</li></ul>"
  },
  {
    "label": "js + unless",
    "source": "- var loggedIn = false\nunless loggedIn\n  p Por favor inicia sesion\n",
    "expected": "<p>Por favor inicia sesion</p>"
  },
  {
    "label": "template mini completo",
    "source": "doctype html\nhtml(lang=\"es\")\n  head\n    meta(charset=\"UTF-8\")\n    title Mi Pagina\n  body\n    h1 Bienvenido\n    p Hola mundo\n",
    "expected": "<!DOCTYPE html><html lang=\"es\"><head><meta charset=\"UTF-8\"><title>Mi Pagina</title></head><body><h1>Bienvenido</h1><p>Hola mundo</p></body></html>"
  },
  {
    "label": "mixin + each complejo",
    "source": "mixin item(label)\n  li.item #{label}\nul\n  each fruit in [\"banana\",\"apple\"]\n    +item(fruit)\n",
    "expected": "<ul><li class=\"item\">banana</li><li class=\"item\">apple</li></ul>"
  }
]
