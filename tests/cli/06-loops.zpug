// Test 06: Loops
// Expected: Iteration over arrays with empty array handling
// Run with: zpug 06-loops.zpug --array items=apple,banana,orange --array fruits=grape,melon --array empty=

h2 Shopping List
ul
  each item in items
    li= item

h2 Fruits
ul
  each fruit in fruits
    li #{fruit}

// Empty array handling with if statement
h2 Products
- var products = []
if products.length>0
  ul
    each product in products
      li= product
else
  p No products available
