prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: zpug
Description: High-performance Pug template engine written in Zig
Version: 0.4.0
URL: https://github.com/carlos-sweb/zig-pug
Libs: -L${libdir} -lzig-pug
Libs.private: -lm
Cflags: -I${includedir}
