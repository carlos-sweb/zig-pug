# Build artifacts (will be rebuilt on user's machine, but keep prebuilts)
build/
*.node
!prebuilts/
!prebuilts/**/*.node

# Development files
.git/
.gitignore
.github/
.vscode/
.idea/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn

# Test files
test/
tests/
*.test.js
*.spec.js

# Coverage
coverage/
.nyc_output/

# Examples (users can get from GitHub)
examples/

# Build scripts for Termux (specific use case)
build-termux.sh
build-prebuilts.sh

# Temporary files
*.tmp
*.log
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Documentation (users can read on GitHub/npm)
docs/
*.md
!/README.md
!/CHANGELOG.md
!/LICENSE.md
!/CONTRIBUTING.md

# Zig cache and build artifacts
.zig-cache/
zig-cache/
zig-out/
