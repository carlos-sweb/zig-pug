//! Example 1: Basic tags and attributes
//! This example shows Pug's basic syntax

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title My First Page
  body
    h1 Welcome to zig-pug
    p This is a simple paragraph
    p.destacado This paragraph has a class
    p#importante This paragraph has an ID
    div.container
      p Content inside a div
