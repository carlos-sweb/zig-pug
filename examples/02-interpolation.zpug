// Example 2: JavaScript Interpolation
// Shows how to use variables and JavaScript expressions

div.user-profile
  h1 Profile of #{name}

  div.info
    p Name: #{name.toUpperCase()}
    p Email: #{email.toLowerCase()}
    p Age: #{age}
    p Age next year: #{age + 1}

  div.calculated
    p Double age: #{age * 2}
    p Is adult: #{age >= 18 ? 'Yes' : 'No'}

  div.methods
    p First letter: #{name[0]}
    p Name length: #{name.length}
