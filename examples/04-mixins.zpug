//! Example 4: Mixins (Reusable Components)
//! Mixins allow you to create reusable components
//! Define a simple mixin
mixin button(text)
  button.btn= text

//! Mixin with multiple parameters
mixin card(title, description)
  div.card
    h3.card-title= title
    p.card-description= description

// Mixin for alerts
mixin alert(type, message)
  div(class="alert alert-"+type)
    p= message

// Using the mixins
div.page
  h1 Mixin Examples

  div.buttons
    +button('Save')
    +button('Cancel')
    +button('Delete')

  div.cards
    +card('Welcome', 'Thank you for using zig-pug')
    +card('Features', 'Supports all Pug syntax')
    +card('Performance', 'Ultra-fast compilation')

  div.alerts
    +alert('success', 'Successful operation')
    +alert('warning', 'Be careful')
    +alert('error', 'Something went wrong')
