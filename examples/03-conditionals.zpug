//! Example 3: Conditionals
//! Shows if/else/unless for conditional logic
div.status
  h2 User Status
  // Simple conditional
  if isLoggedIn
    p.success ✓ Session started
  else
    p.warning Must log in
  // Conditional with expression
  if age >= 18
    p.info Can vote
  else if age >= 16
    p.info Almost able to vote
  else
    p.info Too young to vote
  // Unless (negation)
  unless hasPermission
    p.error ⚠ Access denied
  // Combining with variables
  if role === 'admin'
    button.btn-danger Admin Panel
  else if role === 'user'
    button.btn-primary User Panel
  else
    button.btn-secondary View Profile
