//! Example: Loops in zig-pug
doctype html
html(lang="en")
  head
    title Loops Demo
  body
    h1 User List

    // Simple loop
    ul.users
      each user in users
        li.user #{user}

    // Loop with index
    h2 Numbered Fruits
    ol
      each fruit, i in fruits
        li #{i}: #{fruit}

    // Empty array with else
    h2 Empty Items
    each item in emptyArray
      p #{item}
    else
      p.no-items No items available
