//! Example: Loops in zig-pug
doctype html
html(lang="en")
  head
    title Loops Demo
  body
    h1 User List

    // Simple loop
    ul.users
      each user in users
        li.user #{user}

    h2 Fruits
    ul.fruits
      each fruit in fruits
        li.fruit #{fruit}

    // Handling empty arrays with improved if statement
    h2 Products
    if products.length>0
      ul.products
        each product in products
          li.product #{product}
    else
      p.no-items No products available
