// Example 5: Complete Example
// Combines all features: tags, interpolation, conditionals, mixins

// Reusable mixins
mixin nav-item(text, url)
  li.nav-item
    a(href=url)= text

mixin user-card(user)
  div.user-card
    h3 #{user.name.toUpperCase()}
    p Email: #{user.email.toLowerCase()}
    p Member since: #{user.year}
    if user.isPremium
      span.badge Premium
    else
      span.badge Free

// Page structure
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Dashboard - #{siteName}
    link(rel="stylesheet" href="/styles.css")

  body
    // Navigation
    nav.navbar
      div.container
        h1.logo= siteName
        ul.nav-menu
          +nav-item('Home', '/')
          +nav-item('Profile', '/profile')
          +nav-item('Settings', '/settings')
          if isAdmin
            +nav-item('Admin', '/admin')

    // Main content
    main.main-content
      div.container
        // Header
        header.page-header
          h1 Welcome, #{currentUser.name}!
          p Last login: #{lastLogin}

        // Statistics section
        div.stats-grid
          div.stat-card
            h3 Posts
            p.stat-value #{stats.posts}

          div.stat-card
            h3 Followers
            p.stat-value #{stats.followers}

          div.stat-card
            h3 Following
            p.stat-value #{stats.following}

        // Conditional: show by role
        if currentUser.role === 'admin'
          div.admin-panel
            h2 Admin Panel
            p Total users: #{adminData.totalUsers}
            p New today: #{adminData.newToday}

        // Account status
        div.account-status
          if currentUser.isPremium
            div.premium-info
              h2 ⭐ Premium Account
              p Thank you for your support
              p Valid until: #{premiumUntil}
          else
            div.upgrade-prompt
              h2 Upgrade to Premium
              p Unlock exclusive features
              button.btn-primary Upgrade Now

        // User list (simulated)
        div.users-section
          h2 Active Users
          div.users-grid
            +user-card({name: 'Alice', email: 'alice@example.com', year: 2020, isPremium: true})
            +user-card({name: 'Bob', email: 'bob@example.com', year: 2021, isPremium: false})
            +user-card({name: 'Carol', email: 'carol@example.com', year: 2019, isPremium: true})

    // Footer
    footer.footer
      div.container
        p © #{currentYear} #{siteName}. All rights reserved.
        p Powered by zig-pug
